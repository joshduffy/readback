{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "readback claims v1",
  "type": "object",
  "required": [
    "version",
    "claims"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "type"
      ],
      "propertyNames": {
        "not": {
          "pattern": "(?i)^(command|cmd|exec|shell|token|secret|credential|env|args)$"
        }
      },
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string"
        },
        "repo": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "into": {
          "type": "string"
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).*$"
        },
        "contains": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#]+"
        },
        "marker": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "account": {
          "type": "string"
        },
        "worker": {
          "type": "string"
        },
        "health": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#]+"
        },
        "pr": {
          "type": "integer",
          "minimum": 1
        },
        "require": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expect_status": {
          "type": "integer",
          "default": 200
        },
        "header": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "smoke": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/smokeClaim"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "pr_merged"
            }
          },
          "required": [
            "repo",
            "pr"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "checks_passed"
            }
          },
          "required": [
            "repo",
            "sha"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "commit_on_branch"
            }
          },
          "required": [
            "repo",
            "sha",
            "branch"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "file_exists"
            }
          },
          "required": [
            "path"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "url_serving"
            }
          },
          "required": [
            "url"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "deployment_serving"
            },
            "provider": {
              "const": "cloudflare-workers"
            }
          },
          "required": [
            "provider",
            "sha",
            "url"
          ]
        },
        {
          "properties": {
            "type": {
              "not": {
                "enum": [
                  "pr_merged",
                  "checks_passed",
                  "commit_on_branch",
                  "file_exists",
                  "url_serving",
                  "deployment_serving"
                ]
              }
            }
          }
        }
      ]
    },
    "smokeClaim": {
      "allOf": [
        {
          "$ref": "#/$defs/claim"
        },
        {
          "properties": {
            "type": {
              "const": "url_serving"
            },
            "smoke": false
          }
        }
      ]
    }
  }
}
